NODE_ENV=development
PORT=3000

# Preferred portable SQL Server / tedious configuration
DB_SERVER=localhost
DB_DATABASE=GBPServiceDB
DB_USER=sa
DB_PASSWORD=change-me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Local-development fallback only; do not use this in deployed environments.
# DB_CONNECTION_STRING=Server=localhost;Database=GBPServiceDB;User Id=sa;Password=change-me;TrustServerCertificate=true;

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_DEFAULT_PASSWORD=replace-with-a-strong-admin-password
EMAIL_USER=your-gmail-address@example.com
EMAIL_APP_PASSWORD=your-16-character-gmail-app-password
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
